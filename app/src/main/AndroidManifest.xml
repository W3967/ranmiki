<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- P17：主动消息通知（API 33+ 需要运行时授权，本卡只声明不弹窗） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      P33：vivo ROM 兼容修复（来源：桌面《崩溃原因分析.txt》）。
      该 ROM 在解析带资源引用属性（android:theme / android:roundIcon）的 manifest 时，
      PackageManager 会让 ART 只加载 classes.dex，跳过 classes2.dex，
      导致位于第二个 dex 的 Application 类 ClassNotFoundException。
      修复：去掉 android:theme / android:roundIcon，android:label 用字面量；
      android:icon 单独保留（实测不含 theme 时不触发）。
      代价：启动瞬间窗口背景为系统默认（应用内 Compose 主题不受影响）。
      P214：应用名改为 Ranmiki（角色名「兰未晞」不变）；图标换为 P214 那张，删掉了 adaptive icon
      与两套矢量层，统一用 5 密度 PNG（方形 + 圆形），避免 8.0+ 走 adaptive 把新图盖掉。
    -->
    <application
        android:name=".LanWeiXiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Ranmiki"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
